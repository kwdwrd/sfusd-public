\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Difference-in-differences estimates of the effect of TK promotion on applications to promotion-eligible schools, relative to other schools. All columns include school and cycle fixed effects; standard errors clustered by school (70{} schools) in parentheses; $^{*}$, $^{**}$, $^{***}$: $p<0.10, 0.05, 0.01$. OLS rows use log counts and PPML rows use counts (coefficients in log points). Column (1) uses 2024--25 and 2025--26 only; columns (2)--(4) use 2021--22 through 2026--27, with (3) and (4) adding a linear trend for eligible schools estimated on the pre-period. Column (4) replaces the eligibility indicator with the model's predicted effect under $q = 1$ (computed from 2024--25 shares), so a coefficient of one means applications fell exactly as the model predicts if every promoted family would have ranked its own school. Implied $q$/$f$ inverts the model's predicted difference-in-differences at the OLS estimate. Source: \texttt  {output/application\_effects\_did.csv}, \texttt  {output/application\_effects\_model.csv}.}}{9}{}\protected@file@percent }
\newlabel{tab:application-did}{{2}{9}{}{table.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Left: mean requests per school, indexed to 2024--25, for promotion-eligible schools (orange triangles) and other schools (blue circles); solid lines are first-choice requests and dashed lines all ranked requests. Right: event-study coefficients on eligible $\times $ cycle (log points, 2024--25 $= 0$) for first-choice and all ranked requests, with 95\% confidence intervals clustered by school. Source: \texttt  {output/application\_effects\_event\_study.csv}.}}{9}{}\protected@file@percent }
\newlabel{fig:application-effects}{{3}{9}{}{figure.3}{}}
