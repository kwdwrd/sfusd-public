\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Distaste estimates under alternative measures of school quality. ``Pooled'' rows estimate one $\theta _k$ per school from school and year fixed effects over the stated cycles; ``single year'' rows use that cycle's log-odds alone. Forgone option values are family-weighted over the 601{} acceptances. The free slope's standard error is $0.09$--$0.10$ in every row. Source: \texttt  {output/robustness\_quality\_measurement.csv}.}}{15}{}\protected@file@percent }
\newlabel{tab:robustness}{{3}{15}{}{table.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Left: Spearman rank correlation of single-year school quality $\theta _{kt}$ between each pair of application cycles, over schools present in both (65--86 schools per cycle). Right: each cycle's rank correlation with the main specification's pooled $\theta _k$ (2021--22 through 2024--25, orange triangles). Source: \texttt  {output/quality\_rank\_correlation\_by\_year.csv}, \texttt  {output/quality\_rank\_correlation\_with\_main.csv}.}}{15}{}\protected@file@percent }
